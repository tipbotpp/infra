{
  "id": null,
  "uid": "infrastructure-dashboards",
  "title": "Infrastructure Overview",
  "timezone": "browser",
  "schemaVersion": 37,
  "version": 1,
  "refresh": "10s",
  "tags": ["infrastructure", "backend", "monitoring"],
  "panels": [
    {
      "type": "stat",
      "title": "Total Containers Running",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "count(container_last_seen{name=~\".+\"})",
          "refId": "A"
        }
      ],
      "id": 1,
      "gridPos": { "x": 0, "y": 0, "w": 4, "h": 4 },
      "options": { "colorMode": "value", "graphMode": "none", "justifyMode": "center" },
      "fieldConfig": { "defaults": { "unit": "short" } }
    },
    {
      "type": "stat",
      "title": "FastAPI (port 8005)",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "container_last_seen{name=~\"parser->standalone\"}",
          "refId": "A"
        }
      ],
      "id": 2,
      "gridPos": { "x": 4, "y": 0, "w": 4, "h": 4 },
      "options": { "colorMode": "value", "graphMode": "none", "justifyMode": "center" },
      "fieldConfig": { "defaults": { "unit": "short", "mappings": [{ "type": "value", "value": "1", "text": "UP" }, { "type": "value", "value": "0", "text": "DOWN" }] } }
    },
    {
      "type": "stat",
      "title": "tipbot-backend (port 8000)",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "container_last_seen{name=~\"tipbot-backend\"}",
          "refId": "A"
        }
      ],
      "id": 3,
      "gridPos": { "x": 8, "y": 0, "w": 4, "h": 4 },
      "options": { "colorMode": "value", "graphMode": "none", "justifyMode": "center" },
      "fieldConfig": { "defaults": { "unit": "short", "mappings": [{ "type": "value", "value": "1", "text": "UP" }, { "type": "value", "value": "0", "text": "DOWN" }] } }
    },
    {
      "type": "stat",
      "title": "tipbot-ml (port 8002)",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "container_last_seen{name=~\"tipbot-ml\"}",
          "refId": "A"
        }
      ],
      "id": 4,
      "gridPos": { "x": 12, "y": 0, "w": 4, "h": 4 },
      "options": { "colorMode": "value", "graphMode": "none", "justifyMode": "center" },
      "fieldConfig": { "defaults": { "unit": "short", "mappings": [{ "type": "value", "value": "1", "text": "UP" }, { "type": "value", "value": "0", "text": "DOWN" }] } }
    },
    {
      "type": "stat",
      "title": "PostgreSQL (port 5431)",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "container_last_seen{name=~\"infra-postgres\"}",
          "refId": "A"
        }
      ],
      "id": 5,
      "gridPos": { "x": 16, "y": 0, "w": 4, "h": 4 },
      "options": { "colorMode": "value", "graphMode": "none", "justifyMode": "center" },
      "fieldConfig": { "defaults": { "unit": "short", "mappings": [{ "type": "value", "value": "1", "text": "UP" }, { "type": "value", "value": "0", "text": "DOWN" }] } }
    },
    {
      "type": "stat",
      "title": "Redis (port 6379)",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "container_last_seen{name=~\"infra-redis\"}",
          "refId": "A"
        }
      ],
      "id": 6,
      "gridPos": { "x": 20, "y": 0, "w": 4, "h": 4 },
      "options": { "colorMode": "value", "graphMode": "none", "justifyMode": "center" },
      "fieldConfig": { "defaults": { "unit": "short", "mappings": [{ "type": "value", "value": "1", "text": "UP" }, { "type": "value", "value": "0", "text": "DOWN" }] } }
    },
    {
      "type": "timeseries",
      "title": "Container CPU Usage",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "sum(rate(container_cpu_usage_seconds_total{name=~\"parser->standalone|tipbot-backend|tipbot-worker|tipbot-ml\"}[$__rate_interval])) by (name)",
          "legendFormat": "{{name}}",
          "refId": "A"
        }
      ],
      "id": 7,
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "cpus" } }
    },
    {
      "type": "timeseries",
      "title": "Container Memory Usage (MB)",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "sum(container_memory_working_set_bytes{name=~\"parser->standalone|tipbot-backend|tipbot-worker|tipbot-ml\"}) by (name) / 1024 / 1024",
          "legendFormat": "{{name}}",
          "refId": "A"
        }
      ],
      "id": 8,
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "MB" } }
    },
    {
      "type": "timeseries",
      "title": "FastAPI - Requests Per Second",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{container=\"parser->standalone\"}[$__rate_interval]))",
          "legendFormat": "Total RPS",
          "refId": "A"
        }
      ],
      "id": 9,
      "gridPos": { "x": 0, "y": 12, "w": 8, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "reqps" } }
    },
    {
      "type": "timeseries",
      "title": "FastAPI - Latency P95",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{container=\"parser->standalone\"}[$__rate_interval])) by (le))",
          "legendFormat": "P95 Latency",
          "refId": "A"
        }
      ],
      "id": 10,
      "gridPos": { "x": 8, "y": 12, "w": 8, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "type": "stat",
      "title": "FastAPI Error Rate",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{container=\"parser->standalone\",status=~\"4..|5..\"}[$__rate_interval])) / sum(rate(http_requests_total{container=\"parser->standalone\"}[$__rate_interval])) * 100",
          "refId": "A"
        }
      ],
      "id": 11,
      "gridPos": { "x": 16, "y": 12, "w": 8, "h": 4 },
      "options": { "colorMode": "value", "graphMode": "none", "justifyMode": "center" },
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100 } }
    },
    {
      "type": "stat",
      "title": "FastAPI Uptime (hours)",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "(time() - process_start_time_seconds{container=\"parser->standalone\"}) / 3600",
          "refId": "A"
        }
      ],
      "id": 12,
      "gridPos": { "x": 16, "y": 16, "w": 8, "h": 4 },
      "options": { "colorMode": "value", "graphMode": "none", "justifyMode": "center" },
      "fieldConfig": { "defaults": { "unit": "h" } }
    },
    {
      "type": "timeseries",
      "title": "PostgreSQL - Active Connections",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "pg_stat_database_numbackends{container=\"infra-postgres\"}",
          "legendFormat": "Connections",
          "refId": "A"
        }
      ],
      "id": 13,
      "gridPos": { "x": 0, "y": 20, "w": 8, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "short" } }
    },
    {
      "type": "timeseries",
      "title": "PostgreSQL - Transactions/sec",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "rate(pg_stat_database_xact_commit{container=\"infra-postgres\"}[$__rate_interval])",
          "legendFormat": "Commits",
          "refId": "A"
        },
        {
          "expr": "rate(pg_stat_database_xact_rollback{container=\"infra-postgres\"}[$__rate_interval])",
          "legendFormat": "Rollbacks",
          "refId": "B"
        }
      ],
      "id": 14,
      "gridPos": { "x": 8, "y": 20, "w": 8, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "tps" } }
    },
    {
      "type": "gauge",
      "title": "PostgreSQL Cache Hit Ratio",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "avg(pg_stat_database_blks_hit{container=\"infra-postgres\"} / (pg_stat_database_blks_hit{container=\"infra-postgres\"} + pg_stat_database_blks_read{container=\"infra-postgres\"})) * 100",
          "refId": "A"
        }
      ],
      "id": 15,
      "gridPos": { "x": 16, "y": 20, "w": 8, "h": 8 },
      "options": { "showThresholdLabels": true, "showThresholdMarkers": true },
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100, "thresholds": { "steps": [{ "color": "red", "value": null }, { "color": "yellow", "value": 80 }, { "color": "green", "value": 95 }] } } }
    },
    {
      "type": "timeseries",
      "title": "Redis - Memory Usage (MB)",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "redis_memory_used_bytes{container=\"infra-redis\"} / 1024 / 1024",
          "legendFormat": "Used Memory",
          "refId": "A"
        },
        {
          "expr": "redis_memory_max_bytes{container=\"infra-redis\"} / 1024 / 1024",
          "legendFormat": "Max Memory",
          "refId": "B"
        }
      ],
      "id": 16,
      "gridPos": { "x": 0, "y": 28, "w": 8, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "MB" } }
    },
    {
      "type": "timeseries",
      "title": "Redis - Commands per Second",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "rate(redis_commands_total{container=\"infra-redis\"}[$__rate_interval])",
          "legendFormat": "Total Commands",
          "refId": "A"
        }
      ],
      "id": 17,
      "gridPos": { "x": 8, "y": 28, "w": 8, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "short" } }
    },
    {
      "type": "gauge",
      "title": "Redis Hit Ratio",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "redis_keyspace_hits_total{container=\"infra-redis\"} / (redis_keyspace_hits_total{container=\"infra-redis\"} + redis_keyspace_misses_total{container=\"infra-redis\"}) * 100",
          "refId": "A"
        }
      ],
      "id": 18,
      "gridPos": { "x": 16, "y": 28, "w": 8, "h": 8 },
      "options": { "showThresholdLabels": true, "showThresholdMarkers": true },
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100, "thresholds": { "steps": [{ "color": "red", "value": null }, { "color": "yellow", "value": 70 }, { "color": "green", "value": 90 }] } } }
    },
    {
      "type": "timeseries",
      "title": "MinIO - Storage Usage (GB)",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "minio_bucket_usage_total_bytes{container=\"infra-minio\"} / 1024 / 1024 / 1024",
          "legendFormat": "Total Used",
          "refId": "A"
        }
      ],
      "id": 19,
      "gridPos": { "x": 0, "y": 36, "w": 8, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "GB" } }
    },
    {
      "type": "timeseries",
      "title": "MinIO - Requests per Second",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "rate(minio_s3_requests_total{container=\"infra-minio\"}[$__rate_interval])",
          "legendFormat": "S3 Requests",
          "refId": "A"
        }
      ],
      "id": 20,
      "gridPos": { "x": 8, "y": 36, "w": 8, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "reqps" } }
    },
    {
      "type": "stat",
      "title": "Grafana (port 3100)",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "container_last_seen{name=~\"grafana-dev\"}",
          "refId": "A"
        }
      ],
      "id": 21,
      "gridPos": { "x": 16, "y": 36, "w": 4, "h": 4 },
      "options": { "colorMode": "value", "graphMode": "none", "justifyMode": "center" },
      "fieldConfig": { "defaults": { "unit": "short", "mappings": [{ "type": "value", "value": "1", "text": "UP" }, { "type": "value", "value": "0", "text": "DOWN" }] } }
    },
    {
      "type": "stat",
      "title": "Prometheus (port 3087)",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "container_last_seen{name=~\"prometheus-dev\"}",
          "refId": "A"
        }
      ],
      "id": 22,
      "gridPos": { "x": 20, "y": 36, "w": 4, "h": 4 },
      "options": { "colorMode": "value", "graphMode": "none", "justifyMode": "center" },
      "fieldConfig": { "defaults": { "unit": "short", "mappings": [{ "type": "value", "value": "1", "text": "UP" }, { "type": "value", "value": "0", "text": "DOWN" }] } }
    },
    {
      "type": "stat",
      "title": "VK Bot (port 8001)",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "container_last_seen{name=~\"urfu-vk-bot-bot-1\"}",
          "refId": "A"
        }
      ],
      "id": 23,
      "gridPos": { "x": 16, "y": 40, "w": 4, "h": 4 },
      "options": { "colorMode": "value", "graphMode": "none", "justifyMode": "center" },
      "fieldConfig": { "defaults": { "unit": "short", "mappings": [{ "type": "value", "value": "1", "text": "UP" }, { "type": "value", "value": "0", "text": "DOWN" }] } }
    },
    {
      "type": "stat",
      "title": "User Bot (port 5432)",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "container_last_seen{name=~\"quinqqy-user-bot\"}",
          "refId": "A"
        }
      ],
      "id": 24,
      "gridPos": { "x": 20, "y": 40, "w": 4, "h": 4 },
      "options": { "colorMode": "value", "graphMode": "none", "justifyMode": "center" },
      "fieldConfig": { "defaults": { "unit": "short", "mappings": [{ "type": "value", "value": "1", "text": "UP" }, { "type": "value", "value": "0", "text": "DOWN" }] } }
    }
  ],
  "templating": {
    "list": [
      {
        "name": "interval",
        "type": "interval",
        "auto": true,
        "auto_count": 30,
        "auto_min": "10s",
        "current": { "selected": true, "text": "30s", "value": "30s" },
        "options": [
          { "selected": false, "text": "5s", "value": "5s" },
          { "selected": false, "text": "10s", "value": "10s" },
          { "selected": true, "text": "30s", "value": "30s" },
          { "selected": false, "text": "1m", "value": "1m" },
          { "selected": false, "text": "5m", "value": "5m" }
        ],
        "query": "5s,10s,30s,1m,5m",
        "refresh": 2
      }
    ]
  },
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {
    "refresh_intervals": ["5s", "10s", "30s", "1m", "5m", "15m"],
    "time_options": ["5m", "15m", "1h", "6h", "12h", "24h", "2d", "7d", "30d"]
  }
}