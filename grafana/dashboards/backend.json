{
  "id": null,
  "uid": "fastapi-backend",
  "title": "FastAPI Backend",
  "timezone": "browser",
  "schemaVersion": 37,
  "version": 1,
  "refresh": "5s",
  "tags": ["fastapi", "backend", "python"],
  "panels": [
    {
      "type": "stat",
      "title": "Requests Total",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total[$__rate_interval]))",
          "refId": "A"
        }
      ],
      "id": 1,
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 4 },
      "options": { "colorMode": "value", "graphMode": "none", "justifyMode": "center" },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        }
      }
    },
    {
      "type": "stat",
      "title": "Error Rate",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{status=~\"4..|5..\"}[$__rate_interval])) / sum(rate(http_requests_total[$__rate_interval]))",
          "refId": "A"
        }
      ],
      "id": 2,
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 4 },
      "options": { "colorMode": "value", "graphMode": "none", "justifyMode": "center" },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100
        }
      }
    },
    {
      "type": "stat",
      "title": "Uptime",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "time() - process_start_time_seconds",
          "refId": "A"
        }
      ],
      "id": 3,
      "gridPos": { "x": 12, "y": 0, "w": 6, "h": 4 },
      "options": { "colorMode": "value", "graphMode": "none", "justifyMode": "center" },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Requests Per Second",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total[$__rate_interval]))",
          "refId": "A"
        }
      ],
      "id": 4,
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Latency (95th Percentile)",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket[$__rate_interval])) by (le))",
          "refId": "A"
        }
      ],
      "id": 5,
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Memory Usage",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "process_resident_memory_bytes / 1024 / 1024",
          "refId": "A"
        }
      ],
      "id": 6,
      "gridPos": { "x": 0, "y": 12, "w": 12, "h": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Value" },
            "properties": [{ "id": "unit", "value": "bytes" }]
          }
        ]
      }
    },
    {
      "type": "timeseries",
      "title": "CPU Usage",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "rate(process_cpu_seconds_total[$__rate_interval])",
          "refId": "A"
        }
      ],
      "id": 7,
      "gridPos": { "x": 12, "y": 12, "w": 12, "h": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "cpus"
        }
      }
    },
    {
      "type": "piechart",
      "title": "Requests by Method",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total[$__rate_interval])) by (method)",
          "refId": "A"
        }
      ],
      "id": 8,
      "gridPos": { "x": 0, "y": 20, "w": 12, "h": 8 },
      "options": {
        "pieType": "pie",
        "displayLabels": ["name", "percent"]
      }
    },
    {
      "type": "piechart",
      "title": "Requests by Status Code",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total[$__rate_interval])) by (status)",
          "refId": "A"
        }
      ],
      "id": 9,
      "gridPos": { "x": 12, "y": 20, "w": 12, "h": 8 },
      "options": {
        "pieType": "pie",
        "displayLabels": ["name", "percent"]
      }
    }
  ],
  "templating": {
    "list": [
      {
        "name": "instance",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "Prometheus" },
        "query": "label_values(http_requests_total, instance)",
        "refresh": 2,
        "current": { "selected": true, "text": "All", "value": "$__all" },
        "allValue": ".*",
        "includeAll": true,
        "multi": true
      }
    ]
  },
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {
    "refresh_intervals": ["5s", "10s", "30s", "1m", "5m"],
    "time_options": ["5m", "15m", "1h", "6h", "12h", "24h", "2d", "7d"]
  }
}